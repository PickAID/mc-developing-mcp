{
  "name": "@mcpskill/mcp-server",
  "version": "0.1.0-next.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "mc-developing-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean:dist": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "pnpm run clean:dist && tsc -b",
    "smoke:real-workspace": "tsx src/smoke/real-workspace/real-workspace-smoke.ts",
    "test": "pnpm run clean:dist && tsc -b . && vitest run --root ../.. \"$PWD/src\""
  },
  "dependencies": {
    "@mcpskill/agent-harness": "workspace:*",
    "@mcpskill/datapack-adapter": "workspace:*",
    "@mcpskill/docs-retrieval": "workspace:*",
    "@mcpskill/external-mod-resolver": "workspace:*",
    "@mcpskill/gradle-adapter": "workspace:*",
    "@mcpskill/jar-source-adapter": "workspace:*",
    "@mcpskill/java-jdtls-adapter": "workspace:*",
    "@mcpskill/kubejs-language-service": "workspace:*",
    "@mcpskill/kubejs-types-adapter": "workspace:*",
    "@mcpskill/resource-registry": "workspace:*",
    "@mcpskill/runtime-manager": "workspace:*",
    "@mcpskill/service-profile": "workspace:*",
    "@mcpskill/shared-types": "workspace:*",
    "@mcpskill/source-index": "workspace:*",
    "@mcpskill/source-package-manager": "workspace:*",
    "@mcpskill/vanilla-source-adapter": "workspace:*",
    "@mcpskill/workspace-detector": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "author": "m1hono",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PickAID/mc-developing-mcp.git",
    "directory": "apps/mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP stdio server for Minecraft Java, KubeJS, datapack, resource pack, Gradle, and mod archive development evidence.",
  "keywords": [
    "minecraft",
    "mcp",
    "kubejs",
    "datapack",
    "resourcepack",
    "modding"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "homepage": "https://github.com/PickAID/mc-developing-mcp#readme",
  "bugs": {
    "url": "https://github.com/PickAID/mc-developing-mcp/issues"
  }
}
