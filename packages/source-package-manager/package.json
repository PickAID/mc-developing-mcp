{
  "name": "minecraft-developing-mcp-source-package-manager",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b ../shared-types ../jar-source-adapter ../package-registry ../source-index . && vitest run --root ../.. \"$PWD/src\"/*.test.ts"
  },
  "dependencies": {
    "minecraft-developing-mcp-jar-source-adapter": "workspace:*",
    "minecraft-developing-mcp-package-registry": "workspace:*",
    "minecraft-developing-mcp-source-index": "workspace:*",
    "minecraft-developing-mcp-shared-types": "workspace:*"
  },
  "author": "m1hono",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PickAID/mc-developing-mcp.git",
    "directory": "packages/source-package-manager"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Offline source package acquisition, locking, and installation helpers.",
  "keywords": [
    "minecraft",
    "mcp",
    "kubejs",
    "datapack",
    "resourcepack",
    "modding"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "homepage": "https://github.com/PickAID/mc-developing-mcp#readme",
  "bugs": {
    "url": "https://github.com/PickAID/mc-developing-mcp/issues"
  }
}
