{
  "name": "minecraft-developing-mcp-service-profile",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -b ../shared-types ../workspace-detector ../gradle-adapter ../jar-source-adapter ../java-jdtls-adapter ../kubejs-types-adapter ../datapack-adapter . && vitest run --root ../.. packages/service-profile/src/profile.test.ts"
  },
  "dependencies": {
    "minecraft-developing-mcp-datapack-adapter": "workspace:*",
    "minecraft-developing-mcp-gradle-adapter": "workspace:*",
    "minecraft-developing-mcp-jar-source-adapter": "workspace:*",
    "minecraft-developing-mcp-java-jdtls-adapter": "workspace:*",
    "minecraft-developing-mcp-kubejs-types-adapter": "workspace:*",
    "minecraft-developing-mcp-shared-types": "workspace:*",
    "minecraft-developing-mcp-workspace-detector": "workspace:*"
  },
  "author": "m1hono",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PickAID/mc-developing-mcp.git",
    "directory": "packages/service-profile"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Workspace service-profile synthesis for Minecraft modpack and modding projects.",
  "keywords": [
    "minecraft",
    "mcp",
    "kubejs",
    "datapack",
    "resourcepack",
    "modding"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "homepage": "https://github.com/PickAID/mc-developing-mcp#readme",
  "bugs": {
    "url": "https://github.com/PickAID/mc-developing-mcp/issues"
  }
}
