{
  "name": "@mcpskill/workspace",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules apps/*/dist packages/*/dist coverage apps/*/tsconfig.tsbuildinfo packages/*/tsconfig.tsbuildinfo",
    "publish:check": "node scripts/npm-publish-guard.mjs",
    "publish:dry-run": "node scripts/npm-pack-dry-run.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
