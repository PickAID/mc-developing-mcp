{
  "name": "minecraft-developing-mcp-workspace",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "scripts": {
    "build": "tsc -b && node scripts/build-mcp-server-bundle.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules apps/*/dist packages/*/dist coverage apps/*/tsconfig.tsbuildinfo packages/*/tsconfig.tsbuildinfo",
    "publish:check": "node scripts/npm-publish-guard.mjs",
    "publish:release-check": "MC_DEVELOPING_MCP_RELEASE=1 node scripts/npm-publish-guard.mjs",
    "publish:dry-run": "node scripts/npm-pack-dry-run.mjs",
    "publish:install-smoke": "node scripts/npm-install-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "minecraft-developing-mcp-agent-harness": "workspace:*",
    "minecraft-developing-mcp-datapack-adapter": "workspace:*",
    "minecraft-developing-mcp-docs-retrieval": "workspace:*",
    "minecraft-developing-mcp-external-mod-resolver": "workspace:*",
    "minecraft-developing-mcp-gradle-adapter": "workspace:*",
    "minecraft-developing-mcp-jar-source-adapter": "workspace:*",
    "minecraft-developing-mcp-java-jdtls-adapter": "workspace:*",
    "minecraft-developing-mcp-kubejs-language-service": "workspace:*",
    "minecraft-developing-mcp-kubejs-types-adapter": "workspace:*",
    "minecraft-developing-mcp-package-registry": "workspace:*",
    "minecraft-developing-mcp-resource-registry": "workspace:*",
    "minecraft-developing-mcp-runtime-manager": "workspace:*",
    "minecraft-developing-mcp-service-profile": "workspace:*",
    "minecraft-developing-mcp-shared-types": "workspace:*",
    "minecraft-developing-mcp-source-index": "workspace:*",
    "minecraft-developing-mcp-source-package-manager": "workspace:*",
    "minecraft-developing-mcp-vanilla-source-adapter": "workspace:*",
    "minecraft-developing-mcp-workspace-detector": "workspace:*"
  }
}
